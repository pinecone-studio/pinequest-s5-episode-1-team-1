# Copy to apps/api/.env — never commit real values.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=

# LLM — Gemini (server-side only; never shipped to the app).
# Use a paid-tier key for real users: free-tier API data may be used by Google to improve its products.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order when the main model is overloaded (503/429)
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.8-flash

# Speech — STT: duudlaga (duudlaga.dev, Mongolian) | gemini. Later: buzzasr via apps/speech
STT_PROVIDER=duudlaga
# Used when the main STT fails (e.g. Duudlaga out of credits). A provider that fails for an
# account reason (credits, key) is skipped for 10 minutes.
STT_FALLBACK_PROVIDER=gemini
DUUDLAGA_API_KEY=
# Gemini STT: the dedicated transcription model first (empty = off), then prompted transcription
GEMINI_STT_LIVE_MODEL=gemini-3.5-transcribe-live
GEMINI_STT_MODEL=gemini-3.6-flash
# TTS: elevenlabs (voice 'Ganbold', Khalkha Mongolian; model must support Mongolian: eleven_v4*). Later: oron_tts
TTS_PROVIDER=elevenlabs
# Used when the main TTS fails (empty = off). Gemini TTS is slower (2-10 s) and the free tier
# allows only a few requests per model per day.
TTS_FALLBACK_PROVIDER=gemini
GEMINI_TTS_MODELS=gemini-3.8-flash-lite-tts,gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
# ElevenLabs keys are exactly 51 characters (sk_...)
ELEVENLABS_API_KEY=
# Ganbold (RbMF2tQ1nCK38TfvNGLk) is a Voice Library voice: over the API it needs a paid plan.
# Premade voices work on the free plan and speak Mongolian with eleven_v4_turbo:
# Adam pNInz6obpgDQGcFmaJgB, George JBFqnCBsd6RMkjVDRZzb, Sarah EXAVITQu4vr4xnSDxMaL, Matilda XrExE9yKIg1WjnnlVkGX
ELEVENLABS_VOICE_ID=RbMF2tQ1nCK38TfvNGLk
# eleven_v4: best Mongolian (~1.9 s); eleven_v4_turbo: faster (~1.2 s). Other models have no Mongolian.
ELEVENLABS_MODEL_ID=eleven_v4
SPEECH_SERVICE_URL=http://localhost:8100
SPEECH_SERVICE_TOKEN=

# Optional alternative providers (behind the same interfaces)
OPENAI_API_KEY=

# Supabase. Alarm/timer sync between devices uses sync_devices/sync_alarms
# (supabase/migrations). Unset: synced alarms live in the API process (all devices must use this API).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# External
OPEN_METEO_BASE_URL=https://api.open-meteo.com
# Web search: tavily (https://tavily.com, 1,000 free searches a month, no card) | gemini (Google Search
# grounding; needs billing on the Gemini key)
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# In-app directions (POST /api/v1/maps/directions): a Google Cloud key with the Routes API enabled.
# Server-side only. Restrict it to the Routes API; the app's map tiles use their own keys (apps/mobile/.env).
GOOGLE_MAPS_API_KEY=

# Monitoring
SENTRY_DSN=

# Rate limiting
RATE_LIMIT_PER_MINUTE=30
