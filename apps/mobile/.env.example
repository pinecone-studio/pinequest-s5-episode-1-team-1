# Copy to apps/mobile/.env. EXPO_PUBLIC_* values are bundled into the app and are PUBLIC.
# Never put AI provider keys here — all secret calls go through FastAPI.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# Google Maps tiles on the map screen. Directions come from the backend (GOOGLE_MAPS_API_KEY in apps/api/.env).
# Browser: Maps JavaScript API key, restricted to your site (HTTP referrer, e.g. http://localhost:8081/*).
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
# Builds only (APK / development build); Expo Go uses its own. Maps SDK for Android, restricted to
# package mn.bekhi.app + the build's SHA-1; Maps SDK for iOS, restricted to bundle id mn.bekhi.app.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
