# Copy to apps/speech/.env — GPU speech service (internal; called only by apps/api).
SPEECH_SERVICE_TOKEN=
DEVICE=cuda            # cuda | cpu (cpu works for local dev, but slowly)

# STT — https://huggingface.co/BuzzASR/mongolian (MIT)
BUZZASR_MODEL_ID=BuzzASR/mongolian
BUZZASR_REVISION=      # pin a commit sha before production

# TTS — https://huggingface.co/btsee/oron-tts (CC-BY-4.0 per card), code https://github.com/btseee/oron-tts (MIT)
ORON_TTS_REPO=btsee/oron-tts
ORON_TTS_REVISION=     # pin a commit sha before production
ORON_TTS_NFE_STEP=32
ORON_TTS_CFG_STRENGTH=2.0

HF_HOME=               # model cache directory
