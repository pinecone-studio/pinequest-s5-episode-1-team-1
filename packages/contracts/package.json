{
  "name": "@bekhi/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Wire contract between the BEKHI FastAPI backend and the BEKHI iOS app",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generated/*": "./generated/*",
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "export-schemas": "tsx scripts/export-schemas.ts"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
